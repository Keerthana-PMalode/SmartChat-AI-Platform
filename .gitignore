# ============================================================
# Rasa
# ============================================================

# Keep trained Rasa models in version control so the chatbot
# works immediately after cloning the repository.

# Ignore all Rasa trained models
rasa/models/*.tar.gz

# Keep the current trained model
!rasa/models/20260630-023129-magnetic-cathedral.tar.gz

# Rasa runtime / temporary files
.rasa/
rasa/.config/
rasa/.keras/
*.log

